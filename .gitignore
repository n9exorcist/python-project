# Python environment
venv/
__pycache__/
*.py[cod]

# Sensitive API Keys (CRITICAL)
.env

# Database Persistence (Don't push your local trade history)
*.db
# ...except the swing paper book. It is committed on purpose: Actions
# runners are ephemeral, so this file is how paper state survives between
# scheduled runs. ~45 KB, and it contains no secrets.
!langchain project/app/db/swing.db
*.db-shm
*.db-wal

# Large Vector Database / FAISS
faiss_index/
# If you want to push the index structure but not the data, 
# keep it as is. Otherwise, ignore it.

# Frontend
**/node_modules/
**/build/
.eslintcache

# Logs & Project Artifacts
logs/
*.log
.vscode/

# OS files
.DS_Store
Thumbs.db